# ============================================================================
# Performance Copilot — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA faça commit do .env.local (já está no .gitignore).
# ============================================================================

# Supabase — Project Settings > API no painel do seu projeto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Service Role Key (Project Settings > API > service_role).
# Reservada para tarefas administrativas futuras. NÃO é usada no fluxo
# principal do MVP (toda leitura/escrita passa pelo cliente autenticado,
# que respeita o RLS). Pode ficar em branco em desenvolvimento.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — https://platform.openai.com/api-keys
# Opcional: sem esta chave, o sistema usa apenas o motor de regras
# (lib/analysis/analysis-engine.ts) para gerar o diagnóstico.
OPENAI_API_KEY=

# Modelo usado nas chamadas à OpenAI (opcional, padrão: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# URL pública da aplicação (usada nos links de confirmação de e-mail e
# recuperação de senha do Supabase Auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000
